#compdef blkcp

_blkcp() {
    _arguments -s \
        '(-i --input)'{-i,--input}'[Input file or block device]:input file:_files' \
        '(-o --output)'{-o,--output}'[Output file or block device]:output file:_files' \
        '(-b --block-size)'{-b,--block-size}'[Block size or auto]:block size:(auto 512 4096 64K 1M 4M 8M)' \
        '(-c --count)'{-c,--count}'[Number of blocks to transfer]:blocks count:' \
        '(-l --limit)'{-l,--limit}'[Exact byte transfer limit]:bytes limit:' \
        '(-p --progress)'{-p,--progress}'[Display progress bar on stderr]' \
        '(-q --quiet)'{-q,--quiet}'[Suppress progress and final transfer stats]' \
        '(-e --engine)'{-e,--engine}'[I/O backend engine]:engine:(auto uring async reflink splice sync)' \
        '(-f --force)'{-f,--force}'[Override Target Safety Guard]' \
        '(-n --dry-run)'{-n,--dry-run}'[Simulate execution and print plan without writing]' \
        '--direct[Use Direct I/O (O_DIRECT)]' \
        '--nocache[Evict cache after copy]' \
        '--hash[Compute in-flight SHA-256 digest]' \
        '--json[Emit machine-readable NDJSON telemetry]' \
        '--autotune[Automatically benchmark and select optimal block size]' \
        '--swab[Byte-swap 16-bit word pairs]' \
        '--sync[Pad final input block to full blocksize with NULs]' \
        '--skip[Skip initial bytes of input]:offset:' \
        '--seek[Seek initial bytes of output]:offset:' \
        '--queue-depth[Custom async ringbuffer queue depth]:depth:' \
        '(-h --help)'{-h,--help}'[Display usage help]' \
        '(-v --version)'{-v,--version}'[Display version information]' \
        '*:files:_files'
}

_blkcp "$@"
