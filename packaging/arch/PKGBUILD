# Maintainer: Meik Augenblick <https://github.com/Meik1982>
pkgname=blkcp
pkgver=2.0.0
pkgrel=1
pkgdesc="Next-Gen High-Performance Block Copy Tool for Linux (io_uring, Reflink CoW, Target Safety Guard & TUI)"
arch=('x86_64')
url="https://github.com/Meik1982/blkcp"
license=('GPL-3.0-or-later')
depends=('glibc' 'liburing' 'openssl' 'ncurses')
makedepends=('git' 'gcc' 'make' 'cargo')
source=("$pkgname-$pkgver.tar.gz::https://github.com/Meik1982/blkcp/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('4eda83a63b6bca0cb04cef361882a362022fdf92880ed07baa89930ad1dbd7ff')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  make release
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  make test
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  make DESTDIR="$pkgdir" PREFIX="/usr" install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
