#compdef blkcp

_blkcp_engines() {
    local -a engines
    engines=(
        'uring:Linux io_uring kernel async queue with read-ahead pipelining'
        'async:Multi-threaded pthread ringbuffer double-buffering'
        'reflink:Linux in-kernel zero-copy copy_file_range/reflink'
        'sync:Standard synchronous block I/O engine'
        'auto:Automatic optimal backend selection'
    )
    _describe -t engines 'I/O engine' engines
}

_blkcp_blocksizes() {
    local -a sizes
    sizes=(
        'auto:Dynamic throughput autotuning'
        '512:Standard POSIX sector size'
        '4K:Optimal 4Kn page alignment'
        '64K:Balanced storage block size'
        '1M:High-throughput sequential transfer'
        '4M:NVMe maximum throughput block size'
    )
    _describe -t sizes 'block size' sizes
}

_arguments -s -S \
    '(-i --input)'{-i,--input}'[Input stream or block device]:input file or device:_files' \
    '(-o --output)'{-o,--output}'[Output stream or block device]:output file or device:_files' \
    '(-b --block-size)'{-b,--block-size}'[Uniform block size]:block size:_blkcp_blocksizes' \
    '(-e --engine)'{-e,--engine}'[I/O execution backend driver]:engine:_blkcp_engines' \
    '(-c --count)'{-c,--count}'[Number of blocks to copy]:count:' \
    '(-l --limit)'{-l,--limit}'[Exact byte target limit (e.g. 10G, 500M)]:bytes:' \
    '--skip=[Skip input records or bytes]:offset:' \
    '--seek=[Seek output records or bytes]:offset:' \
    '--autotune[Enable dynamic throughput autotuning (bs=auto)]' \
    '--hash[Compute on-the-fly streaming SHA-256 digest]' \
    '--direct[Bypass OS page cache using O_DIRECT flags]' \
    '--queue-depth=[Ringbuffer slot capacity for async engine (2..1024)]:depth:' \
    '--async-queue=[Alias for --queue-depth]:depth:' \
    '--sparse[Punch sparse holes for NUL-byte blocks]' \
    '--sync[Zero-pad short blocks to input block size]' \
    '(-f --force)'{-f,--force}'[Override Target Safety Guard for mounted devices]' \
    '(-p --progress)'{-p,--progress}'[Display real-time interactive telemetry]' \
    '--json[Emit machine-readable NDJSON telemetry on stderr]' \
    '(-q --quiet)'{-q,--quiet}'[Suppress all diagnostic telemetry and progress]' \
    '(-h --help)'{-h,--help}'[Display usage summary and exit]' \
    '(-v --version)'{-v,--version}'[Display version information and exit]' \
    '*:file:_files'
