# Maintainer: Meik <https://github.com/Meik1982>
pkgname=blkcp
pkgver=1.0.0
pkgrel=1
pkgdesc="Next-Gen High-Performance Block Copy Tool for Linux (io_uring, Reflink CoW, Target Safety Guard & TUI)"
arch=('x86_64')
url="https://github.com/Meik1982/blkcp"
license=('GPL-3.0-or-later')
depends=('glibc' 'liburing' 'openssl' 'ncurses')
makedepends=('git' 'gcc' 'make')
source=("$pkgname-$pkgver.tar.gz::https://github.com/Meik1982/blkcp/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('8baafae834f0c7629dec98547c5f7de72a0ee300e9b7eb1bc19799e79edc3d5b')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  make release
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  make test
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  make DESTDIR="$pkgdir" PREFIX="/usr" install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
