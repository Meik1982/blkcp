# Bash completion for blkcp
_blkcp() {
    local cur prev opts
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    opts="-i --input -o --output -b --block-size -c --count -l --limit -p --progress -q --quiet -e --engine -f --force -n --dry-run --direct --nocache --hash --json --autotune --swab --sync --help --version"

    case "${prev}" in
        -e|--engine)
            COMPREPLY=( $(compgen -W "auto uring async reflink splice sync" -- "${cur}") )
            return 0
            ;;
        -b|--block-size)
            COMPREPLY=( $(compgen -W "auto 512 4096 64K 1M 4M 8M" -- "${cur}") )
            return 0
            ;;
        -i|--input|-o|--output)
            COMPREPLY=( $(compgen -f -- "${cur}") )
            return 0
            ;;
        *)
            ;;
    esac

    if [[ "${cur}" == -* ]] ; then
        COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
        return 0
    fi

    COMPREPLY=( $(compgen -f -- "${cur}") )
    return 0
}
complete -F _blkcp blkcp
